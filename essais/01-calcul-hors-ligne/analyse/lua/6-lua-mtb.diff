      elseif use == nil and kv["highway"] == "service" then
@@ -1726,6 +1733,16 @@
     end
   end
 
+  -- 1BIS-6: a path (or a track made path by 1BIS-5) open to bicycles that is rated mtb:scale 0 to 2, or is a
+  -- member of a relation route=mtb (tag mtb_route=yes added by the osmium preprocessing), is given the
+  -- "separated" cycle lane (3). bicyclecost.cc: path_cyclelane_factor_[3] = use_roads * 0.8 = 0 against
+  -- 0.2 for the shared lane (1), so these ways cost 1.0 instead of 1.2 per unit (17 % less).
+  if use == 27 and (kv["bike_forward"] == "true" or kv["bike_backward"] == "true") and
+     (kv["mtb_route"] == "yes" or string.match(kv["mtb:scale"] or "", "^[012]")) then
+    cycle_lane_right = 3
+    cycle_lane_left = 3
+  end
+
   kv["cycle_lane_right"] = cycle_lane_right
   kv["cycle_lane_left"] = cycle_lane_left
 
