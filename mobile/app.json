{
  "expo": {
    "name": "RutaPulse",
    "slug": "rutapulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rutapulse",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "fr.rutapulse.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": ["fr"]
      }
    },
    "android": {
      "package": "fr.rutapulse.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F4E4C1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.WRITE_SETTINGS"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4E4C1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 176
        }
      ],
      "expo-font",
      "@maplibre/maplibre-react-native",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RutaPulse utilise votre position pour l'afficher sur la carte, seulement quand l'app est ouverte.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": false
        }
      ],
      "expo-status-bar",
      "./plugins/withAndroidAccent",
      "./plugins/withReleaseSigning",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
