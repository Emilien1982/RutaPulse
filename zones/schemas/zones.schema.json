{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Liste des zones (zones.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["zones"],
  "properties": {
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "bbox", "osmExtractUrl", "coastal"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 40
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "bbox": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lonMin", "latMin", "lonMax", "latMax"],
            "properties": {
              "lonMin": { "type": "number", "minimum": -180, "maximum": 180 },
              "latMin": { "type": "number", "minimum": -90, "maximum": 90 },
              "lonMax": { "type": "number", "minimum": -180, "maximum": 180 },
              "latMax": { "type": "number", "minimum": -90, "maximum": 90 }
            }
          },
          "osmExtractUrl": { "type": "string", "pattern": "^https://.+\\.osm\\.pbf$" },
          "coastal": { "type": "boolean" }
        }
      }
    }
  }
}
